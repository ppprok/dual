# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Matches .clang-format: 4-space indent, 120 columns.
[*.{c,cc,cpp,cxx,h,hh,hpp}]
indent_style = space
indent_size = 4
max_line_length = 120

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Unmaintained code and data: keep as is.
[legacy/**]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
