# Doxygen configuration for the public API of dual::dual, dual::common and dual::runc.
#
# Only settings that differ from Doxygen's defaults are listed. Paths are relative to the
# repository root, so run it from there:
#
#     mkdir -p build && doxygen docs/Doxyfile    # HTML in build/docs/html
#
# or build the `dual_docs` target (configure with -DDUAL_BUILD_DOCS=ON), which writes to
# <build dir>/docs/html. INPUT is the public header tree include/dual (what `cmake --install`
# ships); the internal headers in src/ are deliberately left out.

PROJECT_NAME           = dual
PROJECT_BRIEF          = "Dualization algorithms: enumeration of minimal covers of Boolean matrices"
OUTPUT_DIRECTORY       = build/docs
STRIP_FROM_PATH        = include
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES

INPUT                  = docs/mainpage.md \
                         include/dual
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md
FILE_PATTERNS          = *.h *.md

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
# Bodies of @cond INTERNAL ... @endcond blocks are implementation details.
ENABLED_SECTIONS       =

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
SOURCE_BROWSER         = NO
